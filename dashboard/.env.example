#
# Publish your Google Sheet to the web as CSV, then configure:
#
# - Sheet ID: the long id in the URL
# - GID: the tab gid (numeric) for the data sheet
#
# The dashboard fetches:
# https://docs.google.com/spreadsheets/d/{SHEET_ID}/gviz/tq?tqx=out:csv&gid={GID}
#
VITE_GOOGLE_SHEET_ID=1gtCVVuV4n0w9LC_2bePdKjQ5SeMUkaW8eunqQfYmuCE
VITE_GOOGLE_SHEET_GID=243188985

# Optional (recommended): paste the CSV URL directly (overrides ID/GID).
# Example:
# VITE_SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/{SHEET_ID}/gviz/tq?tqx=out:csv&gid={GID}"
VITE_SHEET_CSV_URL=

# Stock entry form — Google Apps Script web app URL (see README)
VITE_MOVEMENTS_SCRIPT_URL=

# Tab name that BOTH the dashboard (published CSV) and stock entry read/write.
# Must match the worksheet tab name in Google Sheets (not the CSV filename).
# Example: reject_list_normalized
VITE_INVENTORY_SHEET_NAME=

# Optional: SKUList tab gid (from URL when SKUList tab is open) — loads product_category
# via published CSV if Apps Script has not been redeployed yet.
# VITE_SKU_LIST_GID=   (gid from URL when SKUList tab is open — optional if sheet name works)
# VITE_SKU_LIST_SHEET_NAME=SKUList
# Or paste the full published CSV URL for SKUList (Publish to web → CSV):
# VITE_SKU_LIST_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-.../pub?gid=...&single=true&output=csv